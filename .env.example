# Copiar a .env y ajustar. Ningun secreto real en el repositorio.
ENVIRONMENT=development
PROJECT_NAME=carpool

# Base de datos
POSTGRES_USER=carpool
POSTGRES_PASSWORD=carpool_dev_password
POSTGRES_DB=carpool
DATABASE_URL=postgresql+asyncpg://carpool:carpool_dev_password@db:5432/carpool

# Redis
REDIS_URL=redis://redis:6379/0

# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:4200,https://localhost
COOKIE_SECURE=true

# Reglas de registro
ALLOWED_EMAIL_SUFFIX=.edu.co

# Correo (Mailpit en desarrollo)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@carpool.local

# Archivos privados
STORAGE_DIR=/data/storage

# Rutas
OSRM_URL=http://osrm:5000

# Superadmin inicial (se usa en el seed)
SUPERADMIN_EMAIL=superadmin@unipamplona.edu.co
SUPERADMIN_PASSWORD=cambia-esta-clave
SUPERADMIN_NAME=Superadministrador
# female o male (campo obligatorio del usuario)
SUPERADMIN_SEX=female

# Limitador
RATE_LIMIT_DEFAULT=120/minute
