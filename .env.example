# Copiar a .env y ajustar. Ningun secreto real en el repositorio.
ENVIRONMENT=development
PROJECT_NAME=carpool

# Base de datos
POSTGRES_USER=carpool
POSTGRES_PASSWORD=carpool_dev_password
POSTGRES_DB=carpool
DATABASE_URL=postgresql+asyncpg://carpool:carpool_dev_password@db:5432/carpool

# Redis
REDIS_URL=redis://redis:6379/0

# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:4200,https://localhost
COOKIE_SECURE=true

# Reglas de registro
ALLOWED_EMAIL_SUFFIX=.edu.co

# Correo. En desarrollo Mailpit lo atrapa todo (http://localhost:8025) y no llega a nadie.
# Para buzones reales usa un SMTP (ver docs/DESPLIEGUE.md, seccion 5), por ejemplo:
#   Gmail:  SMTP_HOST=smtp.gmail.com         SMTP_PORT=587  usuario: tu Gmail, clave de aplicacion
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587  usuario y clave SMTP de Brevo
#   Resend: SMTP_HOST=smtp.resend.com        SMTP_PORT=465  usuario: resend, clave: API key
# SMTP_FROM admite nombre: SMTP_FROM="Carpool UP <tu-correo@gmail.com>"
# Prueba la configuracion con: make email-test TO=tu-correo
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@carpool.local

# Archivos privados
STORAGE_DIR=/data/storage

# Rutas
OSRM_URL=http://osrm:5000

# Superadmin inicial (se usa en el seed)
SUPERADMIN_EMAIL=superadmin@unipamplona.edu.co
SUPERADMIN_PASSWORD=cambia-esta-clave
SUPERADMIN_NAME=Superadministrador
# female o male (campo obligatorio del usuario)
SUPERADMIN_SEX=female

# Limitador
RATE_LIMIT_DEFAULT=120/minute
